# ── Fazo frontend + Next.js backend (MongoDB Atlas) ──────────────────────────
# Copy to .env.local (gitignored) and fill real values.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fazo

# Admin panel auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SEED_USER=admin
ADMIN_SEED_PASS=admin123
ADMIN_SEED_EMAIL=fazocorpinfo@gmail.com

# Telegram — OUTBOUND ONLY (sendMessage to the group). Never set a webhook here:
# the same bot token drives the Mudarris CRM via webhook and must not be disturbed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=5314914121

# Site
SITE_EMAIL=fazocorpinfo@gmail.com

# Cross-origin (mudarris-landing → this backend). Comma-separated allowlist.
CORS_ORIGINS=https://mudarris.fazo.uz,http://localhost:3000

# Ecosystem links shown on the fazo site (public, inlined at build)
NEXT_PUBLIC_MUDARRIS_URL=https://mudarris.fazo.uz
NEXT_PUBLIC_MUDARRIS_CRM_DEMO_URL=https://crm.fazo.uz
